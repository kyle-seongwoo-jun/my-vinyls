{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Scrape Discogs",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/packages/discogs/src/index.ts",
      "cwd": "${workspaceFolder}",
      "args": ["--out", "${workspaceFolder}/list.json"],
      "outFiles": ["${workspaceFolder}/packages/discogs/dist/**/*.js"],
      "env": {
        "DISCOGS_USERNAME": "<discogs-username>",
        "DISCOGS_API_KEY": "<discogs-api-key>"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Next.js dev",
      "cwd": "${workspaceFolder}/apps/web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
