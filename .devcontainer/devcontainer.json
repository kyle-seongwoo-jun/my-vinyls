{
  "name": "Node 22",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "apps/web/app/page.tsx"]
    },
    "vscode": {
      "settings": {},
      "extensions": ["dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"]
    }
  },
  "updateContentCommand": "corepack enable && pnpm install",
  "postAttachCommand": {
    "server": "pnpm dev"
  },
  "portsAttributes": {
    "3000": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [3000]
}
