{
  "name": "@my-vinyls/discogs",
  "version": "1.0.0",
  "description": "Discogs collection scraper and shared record types",
  "type": "module",
  "main": "dist/index.js",
  "types": "./src/types.ts",
  "exports": {
    ".": {
      "//": "types.ts is interfaces only, so consumers resolve the source directly and need no build step",
      "types": "./src/types.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "scrape": "node dist/index.js --out ../../list.json",
    "gen": "node -r dotenv/config dist/index.js --out ../../list.json",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@lionralfs/discogs-client": "^4.1.2"
  },
  "devDependencies": {
    "@swc/core": "^1.10.15",
    "@swc/jest": "^0.2.37",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.12.0",
    "dotenv": "^16.4.7",
    "jest": "^29.7.0",
    "typescript": "^5.9.3"
  }
}
